{{- if not .Values.credentials.existingSecret }}
apiVersion: v1
kind: Secret
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
  name: {{ .Values.credentials.name }}
  namespace: {{ .Values.global.namespace }}
  labels:
    {{- include "cluster-agent.labels" . | nindent 4 }}
type: Opaque
stringData:
  registry-username: {{ .Values.credentials.registryUsername | quote }}
  registry-password: {{ .Values.credentials.registryPassword | quote }}
  cosign.pub: {{ .Values.credentials.cosignPublicKey | quote }}
{{- end }}
